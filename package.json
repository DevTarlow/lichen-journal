{
  "name": "lichen-journal",
  "productName": "Lichen Journal",
  "version": "1.0.0",
  "description": "Private daily writing with offline AI. 100% on your machine, zero subscriptions.",
  "author": "Lichen Journal",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --config electron-builder.json",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.json",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.json",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "smoke:ocr": "node scripts/smoke-ocr.mjs",
    "selftest": "cross-env LICHEN_SELFTEST=1 electron .",
    "model:fetch": "node scripts/fetch-model.mjs",
    "model:verify": "node scripts/verify-model.mjs",
    "ocr:runtime:fetch": "node scripts/fetch-ocr-runtime.mjs",
    "ocr:runtime:verify": "node scripts/verify-ocr-runtime.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "node-llama-cpp": "3.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "node-llama-cpp@3.22.2": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "io.lichen.journal"
}
